{
  "name": "essay-feedback-mvp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"tsc --watch -p tsconfig.frontend.json\" \"tsx watch src/backend/server.ts\"",
    "build": "tsc -p tsconfig.frontend.json && tsc -p tsconfig.backend.json",
    "start": "node dist/backend/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.backend.json",
    "pressure-test": "tsx scripts/pressure-test.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.3.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "openai": "^6.5.0",
    "pdf-parse": "^2.4.5",
    "word-extractor": "^1.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.9.1",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
